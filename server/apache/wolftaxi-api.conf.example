# Wstaw te dyrektywy DO ISTNIEJACEGO VirtualHost HTTPS swojej domeny.
# Wtedy API bedzie dostepne np. jako https://twoja-domena.pl/wolftaxi-api

ProxyPreserveHost On
ProxyPass        /wolftaxi-api/ http://127.0.0.1:8081/
ProxyPassReverse /wolftaxi-api/ http://127.0.0.1:8081/

# Wymagane moduly:
# sudo a2enmod proxy proxy_http headers
# sudo systemctl reload apache2

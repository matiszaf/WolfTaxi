# WolfTaxi 0.5 — osobny vhost. Wymaga:
# sudo a2enmod proxy proxy_http proxy_wstunnel headers rewrite ssl
<VirtualHost *:80>
    ServerName wolftaxi.starcore.pl

    ProxyPreserveHost On

    ProxyPass        /api/ http://127.0.0.1:8081/api/
    ProxyPassReverse /api/ http://127.0.0.1:8081/api/

    ProxyPass        /dispatch/ http://127.0.0.1:8081/dispatch/
    ProxyPassReverse /dispatch/ http://127.0.0.1:8081/dispatch/

    ProxyPass        /track/ http://127.0.0.1:8081/track/
    ProxyPassReverse /track/ http://127.0.0.1:8081/track/

    ProxyPass        /health http://127.0.0.1:8081/health
    ProxyPassReverse /health http://127.0.0.1:8081/health

    ProxyPass        /ws ws://127.0.0.1:8081/ws
    ProxyPassReverse /ws ws://127.0.0.1:8081/ws

    RedirectMatch 302 ^/$ /dispatch/

    ErrorLog ${APACHE_LOG_DIR}/wolftaxi-error.log
    CustomLog ${APACHE_LOG_DIR}/wolftaxi-access.log combined
</VirtualHost>

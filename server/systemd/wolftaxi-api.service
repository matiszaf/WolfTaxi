[Unit]
Description=WolfTaxi Oracle API
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=wolftaxi
Group=wolftaxi
WorkingDirectory=/opt/wolftaxi-api
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /opt/wolftaxi-api/src/index.js
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
